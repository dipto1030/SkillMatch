# SkillMatch Environment Configuration

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://skillmatch:skillmatch@localhost:5432/skillmatch

# Redis
REDIS_URL=redis://localhost:6379

# Telegram Bot (Player-facing)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
WEBAPP_URL=http://localhost:5173

# Telegram Bot (Admin alerts)
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE
ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID_HERE

# Telegram Webhook
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_URL=https://yourserver.com/webhook/telegram

# Admin Panel
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
ADMIN_JWT_EXPIRY=24h

# File Storage (local for now)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Timezone
PLATFORM_TIMEZONE=Asia/Dhaka
